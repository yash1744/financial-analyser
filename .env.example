# Application
APP_NAME=finance-app
ENVIRONMENT=local          # local | staging | production
DEBUG=true
LOG_LEVEL=INFO

# API
API_V1_PREFIX=/api/v1

# Database (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://finance:finance@localhost:5432/finance
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Plaid (https://dashboard.plaid.com/developers/keys)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox          # sandbox | production
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
PLAID_WEBHOOK_URL=

# Fernet key for encrypting Plaid access tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Anthropic API key for the /ai/chat endpoints (console.anthropic.com)
ANTHROPIC_API_KEY=

# LLM provider: "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic
# OpenAI API key + model, used when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1

# Email delivery for verification / password-reset messages.
# "console" (default) logs emails instead of sending — no SMTP needed locally.
EMAIL_BACKEND=console      # console | smtp
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM="Finance <no-reply@localhost>"
# Browser-facing origin used in emailed links
APP_BASE_URL=http://localhost:3000
# EMAIL_VERIFICATION_TTL_HOURS=24
# PASSWORD_RESET_TTL_MINUTES=60

# Receipt image storage. "local" writes under LOCAL_STORAGE_DIR (dev, no
# cloud creds needed); "r2" uses Cloudflare R2 via its S3-compatible API.
STORAGE_BACKEND=local      # local | r2
LOCAL_STORAGE_DIR=.data/receipts
# Required when STORAGE_BACKEND=r2 (Cloudflare dashboard → R2 → API tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# RECEIPT_MAX_IMAGE_BYTES=10485760   # 10 MiB per upload
# RECEIPT_MAX_IMAGES=10              # per transaction

# Auth: secret for signing JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY=<paste generated secret>  (unset = insecure dev default)
# JWT_EXPIRY_HOURS=24
