# Application
APP_NAME=finance-app
ENVIRONMENT=local          # local | staging | production
DEBUG=true
LOG_LEVEL=INFO

# API
API_V1_PREFIX=/api/v1

# Database (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://finance:finance@localhost:5432/finance
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Plaid (https://dashboard.plaid.com/developers/keys)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox          # sandbox | production
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
PLAID_WEBHOOK_URL=

# Fernet key for encrypting Plaid access tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Anthropic API key for the /ai/chat endpoints (console.anthropic.com)
ANTHROPIC_API_KEY=

# LLM provider: "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic
# OpenAI API key + model, used when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
